+    def _draw_screen_cover(self, color: str | None = None, alpha: int | None = None):
+        """Draw a translucent full-stage overlay; Pillow gives smooth alpha on Tk 8.6."""
+        if color is None or alpha is None:
+            if self._screen_cover is None:
+                if self._effect_overlay_id is not None:
+                    try: self.canvas.delete(self._effect_overlay_id)
+                    except tk.TclError: pass
+                self._effect_overlay_id = None
+                self._effect_photo = None
+                return
+            color, alpha = self._screen_cover
+        alpha = max(0, min(255, int(alpha)))
+        if alpha <= 0:
+            if self._effect_overlay_id is not None:
+                self.canvas.delete(self._effect_overlay_id)
+            self._effect_overlay_id = None
+            self._effect_photo = None
+            return
+        w = max(1, self.canvas.winfo_width())
+        h = max(1, self.canvas.winfo_height())
+        try:
+            rgb = tuple(int(color[i:i+2], 16) for i in (1, 3, 5))
+        except (ValueError, TypeError, IndexError):
+            rgb = (0, 0, 0)
+            color = "#000000"
+        if Image is not None and ImageTk is not None:
+            rgba = Image.new("RGBA", (w, h), rgb + (alpha,))
+            photo = ImageTk.PhotoImage(rgba, master=self.window)
+            if self._effect_overlay_id is None:
+                self._effect_overlay_id = self.canvas.create_image(0, 0, image=photo, anchor="nw", tags=("effect-overlay",))
+            else:
+                self.canvas.itemconfigure(self._effect_overlay_id, image=photo)
+                self.canvas.coords(self._effect_overlay_id, 0, 0)
+            self._effect_photo = photo
+        else:
+            # Fallback for a Pillow-free developer environment.
+            pattern = "" if alpha >= 245 else ("gray75" if alpha >= 180 else ("gray50" if alpha >= 110 else ("gray25" if alpha >= 45 else "gray12")))
+            if self._effect_overlay_id is not None:
+                self.canvas.delete(self._effect_overlay_id)
+            self._effect_overlay_id = self.canvas.create_rectangle(0, 0, w, h, fill=color, outline="", stipple=pattern, tags=("effect-overlay",))
+
+    def _run_visual_effect(self, event: dict[str, Any]):
+        """Play a blocking script effect and resume the interpreter when it ends."""
+        if self._effect_job is not None:
+            try: self.window.after_cancel(self._effect_job)
+            except tk.TclError: pass
+            self._effect_job = None
+        kind = str(event.get("effect", "flash"))
+        duration = max(0, min(10000, int(event.get("ms", 300))))
+        color = str(event.get("color", "#000000"))
+        if not re.fullmatch(r"#[0-9a-fA-F]{6}", color): color = "#000000"
+        visible = self._typing_text[:self._typing_index] if self._typing_job is not None else self._typing_text
+        if kind == "bgfade":
+            # Render the previous background first; the interpreter already stores the new one.
+            new_background = self.engine.background
+            self.engine.background = str(event.get("previous_background", ""))
+            self.refresh_stage(visible, self._typing_speaker, self.current_choices)
+            self.engine.background = new_background
+        else:
+            # Commands such as bg/chara immediately before an effect are reflected first.
+            self.refresh_stage(visible, self.engine.speaker, self.current_choices)
+        if kind == "shake":
+            self._shake_item_ids = tuple(i for i in self.canvas.find_all() if i != self._effect_overlay_id)
+            self._shake_last_offset = (0, 0)
+            intensity = max(1, min(40, int(event.get("intensity", 8))))
+            frames = max(1, min(24, duration // 18 if duration else 1))
+            start = time.monotonic()
+            def shake_frame(index=0):
+                elapsed = (time.monotonic() - start) * 1000
+                progress = min(1.0, elapsed / max(1, duration))
+                if progress >= 1.0 or duration == 0:
+                    dx, dy = self._shake_last_offset
+                    if self._shake_item_ids: self.canvas.move(self._shake_item_ids, -dx, -dy)
+                    self._shake_last_offset = (0, 0)
+                    self._shake_item_ids = ()
+                    self._effect_job = None
+                    self.step()
+                    return
+                envelope = 1.0 - progress
+                phase = index % 4
+                offset = ((int(intensity * envelope), 0), (0, -int(intensity * envelope)), (-int(intensity * envelope), 0), (0, int(intensity * envelope)))[phase]
+                dx, dy = offset
+                old_x, old_y = self._shake_last_offset
+                if self._shake_item_ids: self.canvas.move(self._shake_item_ids, dx-old_x, dy-old_y)
+                self._shake_last_offset = offset
+                self._effect_job = self.window.after(18, lambda: shake_frame(index+1))
+            shake_frame()
+            return
+
+        # For bgfade, keep the old picture visible until the screen is covered,
+        # then redraw the new background underneath and reveal it smoothly.
+        if kind == "fadein":
+            self._screen_cover = (color, 255)
+            self._draw_screen_cover()
+            start_alpha, end_alpha = 255, 0
+        elif kind == "fadeout":
+            start_alpha, end_alpha = 0, 255
+        elif kind == "bgfade":
+            start_alpha, end_alpha = 0, 255
+        else:  # flash
+            start_alpha, end_alpha = 220, 0
+        frames = max(1, min(24, duration // 24 if duration else 1))
+        interval = max(16, duration // frames) if duration else 0
+        start = time.monotonic()
+        midpoint_done = False
+        def cover_frame():
+            nonlocal midpoint_done
+            elapsed = (time.monotonic() - start) * 1000
+            progress = 1.0 if duration == 0 else min(1.0, elapsed / duration)
+            alpha = int(start_alpha + (end_alpha-start_alpha) * progress)
+            self._draw_screen_cover(color, alpha)
+            if kind == "bgfade" and progress >= 0.5 and not midpoint_done:
+                midpoint_done = True
+                visible = self._typing_text[:self._typing_index] if self._typing_job is not None else self._typing_text
+                self.refresh_stage(visible, self._typing_speaker, self.current_choices)
+                # Reapply full cover after the scene redraw.
+                self._draw_screen_cover(color, alpha)
+            if progress < 1.0:
+                self._effect_job = self.window.after(interval or 1, cover_frame)
+                return
+            self._effect_job = None
+            if kind == "fadeout":
+                self._screen_cover = (color, 255)
+                self._draw_screen_cover()
+            else:
+                self._screen_cover = None
+                self._draw_screen_cover()
+            self.step()
+        cover_frame()
 
