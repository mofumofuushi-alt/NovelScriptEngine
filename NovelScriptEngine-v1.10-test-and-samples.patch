+    def test_script_visual_effect_commands_emit_blocking_events(self):
+        source = '''*start
+fadeout 420 #000000
+bgfade "assets/bg_riverside.svg" 650
+flash #ffffff 160
+shake 300 9
+fadein 500 #000000
+text "演出確認"
+end
+'''
+        engine = ScenarioEngine(source)
+        self.assertEqual(engine.advance(), {"type": "effect", "effect": "fadeout", "ms": 420, "color": "#000000"})
+        self.assertEqual(engine.advance(), {"type": "effect", "effect": "bgfade", "ms": 650, "color": "#000000", "previous_background": ""})
+        self.assertEqual(engine.background, "assets/bg_riverside.svg")
+        self.assertEqual(engine.advance(), {"type": "effect", "effect": "flash", "ms": 160, "color": "#ffffff"})
+        self.assertEqual(engine.advance(), {"type": "effect", "effect": "shake", "ms": 300, "intensity": 9})
+        self.assertEqual(engine.advance(), {"type": "effect", "effect": "fadein", "ms": 500, "color": "#000000"})
+        self.assertEqual(engine.advance(), {"type": "text", "text": "演出確認", "speaker": ""})
+
+    def test_visual_effect_validation_and_project_roundtrip(self):
+        valid = '''*start
+fadeout 500 #000000
+fadein 300 #000000
+flash #ffffff 180
+shake 350 8
+bgfade "assets/bg_shrine.svg" 700
+end
+'''
+        self.assertFalse([x for x in validate_script(valid) if x[0] == "エラー"])
+        invalid = '''*start
+fadeout 12000 #xyz
+flash red -5
+shake 200 99
+bgfade "bg.png" 20000
+'''
+        self.assertTrue([x for x in validate_script(invalid) if x[0] == "エラー"])
+        exported = project_to_nse(nse_to_project(valid))
+        for command in ("fadeout 500 #000000", "fadein 300 #000000", "flash #ffffff 180", "shake 350 8", 'bgfade "assets/bg_shrine.svg" 700'):
+            self.assertIn(command, exported)
+
