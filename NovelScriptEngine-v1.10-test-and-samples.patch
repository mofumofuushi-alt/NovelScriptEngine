+# Visual effects run as blocking, timed transitions without letting clicks skip them.
+effect_script='''*start
+bg "assets_png/bg_station.png"
+fadeout 40 #000000
+bgfade "assets_png/bg_riverside.png" 60
+flash #ffffff 40
+shake 50 4
+fadein 40 #000000
+text "演出テスト完了"
+end
+'''
+effect_player=NativePlayer(app,effect_script,ROOT)
+root.update_idletasks(); root.update()
+assert effect_player._effect_job is not None, 'fadeout should start a blocking animation'
+assert str(effect_player.next_btn["state"]) == 'disabled', 'advance button must be disabled during a visual effect'
+end_time=time.monotonic()+1.5
+while time.monotonic()<end_time and effect_player._typing_text != '演出テスト完了':
+    root.update_idletasks(); root.update(); time.sleep(0.01)
+assert effect_player._typing_text == '演出テスト完了', 'all effects should finish and resume the script'
+assert effect_player.engine.background == 'assets_png/bg_riverside.png'
+assert effect_player._screen_cover is None and effect_player._effect_job is None, 'fadein should restore a clear scene'
+effect_player.close()
+
 click_player.close(); root.destroy()
