+    def _set_screen_mode(self, mode: str, persist: bool = True):
+        """Switch the game stage between a 1280x720 window and monitor fullscreen."""
+        mode = mode if mode in {"windowed", "fullscreen"} else "windowed"
+        fullscreen = mode == "fullscreen"
+        try:
+            # Re-pack the canvas so no editor controls or margins consume game area.
+            self.canvas.pack_forget()
+            if fullscreen:
+                self.footer.pack_forget()
+                self.canvas.pack(fill="both", expand=True, padx=0, pady=0)
+                self.window.attributes("-fullscreen", True)
+            else:
+                self.window.attributes("-fullscreen", False)
+                self.canvas.pack(fill="both", expand=True, padx=12, pady=(12, 6))
+                if not self.footer.winfo_manager():
+                    self.footer.pack(fill="x")
+                self.window.geometry("1304x792")
+                self.window.minsize(900, 600)
+        except tk.TclError:
+            # Keep the app usable on window managers without fullscreen support.
+            if fullscreen:
+                try: self.window.state("zoomed")
+                except tk.TclError: pass
+            else:
+                try: self.window.state("normal")
+                except tk.TclError: pass
+        self.screen_mode = mode
+        self.display_settings["screen_mode"] = mode
+        if persist:
+            self.app.display_settings["screen_mode"] = mode
+            try:
+                save_display_settings(self.app.display_settings)
+            except OSError:
+                pass
+
+    def _toggle_screen_mode(self, _event=None):
+        self._set_screen_mode("windowed" if self.screen_mode == "fullscreen" else "fullscreen")
+        return "break"
+
+    def _leave_fullscreen(self, _event=None):
+        if self.screen_mode == "fullscreen":
+            self._set_screen_mode("windowed")
+            return "break"
+        return None
+
